# Spring Boot Backend API Base URL
# Local Development:
VITE_API_BASE_URL=http://localhost:8080/api

# Production (Render / Cloud Deployment):
# Note: Works both with or without '/api' suffix (e.g. https://smart-digital-locker.onrender.com/api or https://smart-digital-locker.onrender.com)
VITE_API_BASE_URL=https://smart-digital-locker.onrender.com/api
